# ─────────────────────────────────────────
# JobLink Backend — Environment Variables
# ─────────────────────────────────────────
# Copy this file to `.env` and fill in REAL values.
# NEVER commit `.env` — it is in .gitignore.
# ─────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development

# MongoDB
# Local:
MONGO_URI=mongodb://localhost:27017/joblink
# Or MongoDB Atlas (replace placeholders):
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/joblink?retryWrites=true&w=majority

# JWT — MUST be changed to a long random string in production
JWT_SECRET=replace_with_long_random_secret_string
JWT_EXPIRES_IN=7d

# File Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# Frontend URL — for CORS
CLIENT_URL=http://localhost:3000

# Optional — Email notifications (Nodemailer)
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=