# ─────────────────────────────────────────
# JobLink Frontend — Environment Variables
# ─────────────────────────────────────────
# Copy this file to `.env` and fill in REAL values.
# NEVER commit `.env` — it is in .gitignore.
#
# NOTE: Only variables prefixed with REACT_APP_ are exposed to
#       the browser by Create React App. Never put secrets here.
# ─────────────────────────────────────────

REACT_APP_API_URL=http://localhost:5000/api
REACT_APP_APP_NAME=JobLink